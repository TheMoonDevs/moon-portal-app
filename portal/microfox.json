{
  "projectId": "40c83da4-4d55-4ff1-af51-b1ddc96ab271",
  "publish": {
    "subdomain": "portal",
    "agentName": "portal",
    "handles": {
      "agent": "/agent",
      "openapi": "/docs.json",
      "public": "/public"
    }
  },
  "deployment": {
    "apiMode": "staging",
    "apiVersion": "v2",
    "ignorePatterns": [".build/**", "package-lock.json"]
  },
  "worker": {
    "externalDeps": ["@microfox/puppeteer-sls", "@sparticuz/chromium"],
    "includeNodeModules": false,
    "groups": {
      "scraper": {
        "includeNodeModules": true
      }
    }
  }
}
