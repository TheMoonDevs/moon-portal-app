NEXTAUTH_SECRET=<NEXTAUTH_SECRET>
DATABASE_URL=<DB_URL>
# Worksheet rows (MongoDB); DB name derived from URL path (e.g. mongodb://host:27017/worksheet_db)
WORKSHEET_DB_URL=<DB_URL>
ALLOWED_METHODS="GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS"
ALLOWED_ORIGIN="http://localhost:3001,http://localhost:3000,https://themoondevs.com" # * for all
ALLOWED_HEADERS="Content-Type, Authorization"
EXPOSED_HEADERS=""
MAX_AGE="86400" # 60 * 60 * 24 = 24 hours
CREDENTIALS="true"
NEXT_PUBLIC_SHORT_LINK_BASE_URL=http://localhost:3000
METADATA_API_URL="https://apps.themoondevs.com/birthdaybook/links/metadata";
METADATA_API_TOKEN="kjbdvfelrkbviAkjelknfvjdknvkndknvikbvroiebsrjvb";
NEXT_PUBLIC_APP_BASE_URL=https://moon-pwa-survey.vercel.app
NEXT_PUBLIC_TMD_PORTAL_API_KEY=

HASH_SECRET="simplesamosabackend"
NEXT_PUBLIC_HASH_SECRET="simplesamosafrontend"

# Email (Resend). RESEND_DOMAIN is the domain verified in Resend; each feature
# sends from its own address on it, e.g. hiring uses careers@<RESEND_DOMAIN>.
RESEND_API_KEY=
RESEND_DOMAIN=
# Optional: signing secret of a Resend webhook pointed at
# /api/hiring/emails/webhook, to show delivered / opened / bounced.
RESEND_WEBHOOK_SECRET=

# Messages (lib/chat). Ably carries live updates (new messages, ticks,
# typing, online). Without it chats still work but poll every few seconds.
# Server-only: never add a NEXT_PUBLIC_ copy.
ABLY_API_KEY=
# Chat files use the same Spaces bucket (SPACES_*); allow browser uploads
# once with: node --env-file=.env scripts/chat-spaces-cors.mjs <portal origin>

# Mobile app test sign-in for App Store and Google Play reviewers (code TEST12,
# then this email and password; lib/mobile/testSignIn.ts). The email must be an
# existing Portal user, best a reviewer account in a demo company. Leave empty
# to turn it off. Server-only: never add a NEXT_PUBLIC_ copy.
MOBILE_TEST_EMAIL=
MOBILE_TEST_PASSWORD=

# Mobile app versions (app/api/mobile/config). MOBILE_MIN_VERSION blocks older
# store builds until they update. MOBILE_LATEST_VERSION (or _IOS / _ANDROID when
# the stores differ) is the newest released version: older builds show
# "Portal x.y is out" in Notifications. MOBILE_APP_STORE_URL is the App Store
# link once the app is public; Play's link has a default.
MOBILE_MIN_VERSION=
MOBILE_LATEST_VERSION=
MOBILE_LATEST_VERSION_IOS=
MOBILE_LATEST_VERSION_ANDROID=
MOBILE_APP_STORE_URL=
MOBILE_PLAY_STORE_URL=
