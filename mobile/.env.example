# Copy to .env.local for local development. On EAS, set these as the
# project's environment variables on expo.dev instead. See README.md.

# The portal the app talks to (no trailing slash).
EXPO_PUBLIC_PORTAL_URL=https://portal.themoondevs.com

# From `npx eas-cli@latest init` (expo.dev project id and account name).
EAS_PROJECT_ID=
EAS_OWNER=

# Google sign-in: the Web client id Firebase made for the themoondevs
# project, and an iOS OAuth client id for com.themoondevs.portal.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
